NODE_ENV=development
PORT=3333
CORS_ALLOWED_ORIGINS=http://localhost:3000
# URL do frontend -- somada a CORS_ALLOWED_ORIGINS quando configurada
APP_WEB_URL=http://localhost:3000

# Mesmo projeto Supabase do repo antigo (schema recriado via supabase/migrations)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mesmo app OAuth do Mercado Livre ja cadastrado
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=http://localhost:3333/api/v1/integrations/mercado-livre/callback
MERCADO_LIVRE_AUTH_BASE_URL=https://auth.mercadolivre.com.br
MERCADO_LIVRE_API_BASE_URL=https://api.mercadolibre.com

# Opcionais -- ate serem configuradas, /integrations/magalu/authorize responde
# 503 em vez de derrubar o boot (ver modules/integrations/magalu/README.md)
MAGALU_CLIENT_ID=
MAGALU_CLIENT_SECRET=
MAGALU_REDIRECT_URI=http://localhost:3333/api/v1/integrations/magalu/callback
MAGALU_AUTH_BASE_URL=https://id.magalu.com
MAGALU_API_BASE_URL=https://api.magalu.com

JOB_EXECUTION_MODE=direct
# Secret usado pelo GitHub Actions (cron.yml) nas rotas /cron/*
CRON_SECRET=
# Segundo secret valido nas mesmas rotas /cron/*, usado pelo pg_cron do
# Supabase (gatilho redundante -- ver comentario em cron-routes.ts)
SUPABASE_CRON_SECRET=
